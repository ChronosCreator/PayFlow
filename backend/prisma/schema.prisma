
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum OrderStatus {
  CREATED
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum UserRole {
  ADMIN
  MERCHANT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(MERCHANT)

  merchant     Merchant?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Merchant {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])

  products  Product[]
  customers Customer[]
  orders    Order[]
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("INR")
  active      Boolean  @default(true)

  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
}

model Customer {
  id         String   @id @default(uuid())
  name       String
  email      String
  phone      String?

  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  orders     Order[]
  payments   Payment[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([merchantId])
  @@index([email])
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique
  idempotencyKey String?     @unique

  amount         Decimal     @db.Decimal(12, 2)
  currency       String      @default("INR")
  status         OrderStatus @default(CREATED)
  retryLockUntil DateTime?

  merchantId     String
  merchant       Merchant    @relation(fields: [merchantId], references: [id])

  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])

  payments       Payment[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([merchantId])
  @@index([customerId])
  @@index([status])
}

model Payment {
  id                String        @id @default(uuid())

  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)

  provider          String
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique

  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])

  merchantId        String
  merchant          Merchant      @relation(fields: [merchantId], references: [id])

  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id])

  webhookEvents     WebhookEvent[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@index([merchantId])
  @@index([customerId])
  @@index([status])
}

model WebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  provider    String
  event       String

  paymentId   String?
  payment     Payment? @relation(fields: [paymentId], references: [id])

  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([paymentId])
  @@index([provider, event])
}
